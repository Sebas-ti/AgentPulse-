# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agentpulse
REDIS_URL=redis://localhost:6379/0

# Environment & Debug
ENVIRONMENT=development
DEBUG=true

# Auth
AUTH_PROVIDER=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# LLM Judge & Guardrails
JUDGE_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=

# Ingest Limits
MAX_BATCH_SIZE=500
RATE_LIMIT_PER_MINUTE=1200
